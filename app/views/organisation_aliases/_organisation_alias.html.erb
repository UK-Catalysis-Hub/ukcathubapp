<div id="<%= dom_id organisation_alias %>">
  <p>
    <strong>Organisation:</strong>
    <%= organisation_alias.organisation_id %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= organisation_alias.name %>
  </p>

  <p>
    <strong>Alias type:</strong>
    <%= organisation_alias.alias_type %>
