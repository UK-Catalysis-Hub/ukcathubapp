<div class="container">
  <div class="row">
    <div class="col-md-12">
      <!-- Top DIV: search, order, reset -->
         <p id="notice"><%= notice %></p>
           <%= form_tag nil, method: :get do %>
            <!-- Field for searching by institution -->
             <%= hidden_field_tag 'search[order]', org_search.order.definition.request_value if org_search.order %>
             <div class="row">
               <div class="col-md-1">
                 <b> Search: </b>
               </div>
               <div class="col-md-5">
                 <% name_filter = org_search.filter(:name) %>
                 <%= text_field_tag 'search[name]', name_filter.value, class: 'form-control', placeholder: name_filter.name %>
               </div>
               <div class="col-md-4">
                 <!-- Set sort order -->
                   <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown"> Sort by: <%= org_search.order.title if org_search.order %>
                   <span class="caret"></span></button>
                   <ul class="dropdown-menu">
                     <% org_search.orders.reject(&:active).each do |order| %>
                       <li><a class="dropdown-item" href=<%= order.by.path %>><%= order.title %></a></li>
                     <% end %>
                   </ul>
               </div>
               <div class="col-md-2">
                 <%= link_to 'reset', '?', class: 'btn  btn-success float-right' %>
               </div>
             </div>
           <% end %>
    </div>
  </div>
  <div class="row">
       <div class="col-md-3 rounded border-light bg-light " >
         <!-- left DIV: facet filters -->
           <%= form_tag nil, method: :get do %>
             <!-- Field for searching by title -->
             <%= hidden_field_tag 'search[order]', org_search.order.definition.request_value if org_search.order %>
             <!-- Facet filter for institution -->
             <% [:country].each do |filter_name| %>
                <% filter = org_search.filter(filter_name) %>
                <div class="filter">
                  <div class="filter-title">
                    <%= filter.name %>
                    <span class="small text-muted">
                      <%= "(#{filter.facet.length})" %>
                    </span>
                  </div>
                  <div class="filter-values">
                    <ul class="selected">
                      <% filter.selected.each do |entity| %>
                        <% display = entity %>
                        <li>
                          <%= link_to display, filter.remove(entity).path %>
                        </li>
                      <% end %>
                    </ul>
                    <ul class="selectable">
                      <% filter.facet.reject(&:selected).each do |facet_value| %>
                        <% entity = facet_value.entity %>
                        <li>
                          <% display = entity %>
                          <%= link_to display, filter.add(entity).path %>
                          <span class="count">
                            <!--Cannot have inactives the filter does not work with scopes -->
                            <%= "(#{facet_value.count})" %>
                          </span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %><!--end of each do-->
             <!-- Facet filter for department -->
             <% [:sector].each do |filter_name| %>
                <% filter = org_search.filter(filter_name) %>
                <div class="filter">
                  <div class="filter-title">
                    <%= filter.name %>
                    <span class="small text-muted">
                      <%= "(#{filter.facet.length})" %>
                    </span>
                  </div>
                  <div class="filter-values">
                    <ul class="selected">
                      <% filter.selected.each do |entity| %>
                        <% display = entity %>
                        <li>
                          <%= link_to display, filter.remove(entity).path %>
                        </li>
                      <% end %>
                    </ul>
                    <ul class="selectable">
                      <% filter.facet.reject(&:selected).each do |facet_value| %>
                        <% entity = facet_value.entity %>
                        <% if entity != nil %>
                          <li>
                            <% display = entity %>
                            <%= link_to display, filter.add(entity).path %>
                            <span class="count">
                              <!--Cannot have inactives the filter does not work with scopes -->
                              <%= "(#{facet_value.count})" %>
                            </span>
                          </li>
                        <% end %>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %><!--end of each do-->
              <% end %><!--end of form for facets-->
    </div> <!-- Col left facets-->
    <div class="col-md-9"><!--List of items in page -->
      <%= will_paginate @organisations, renderer: WillPaginate::ActionView::BootstrapLinkRenderer  %>
      <b> <%= @organisations.count%> Institutions found</b>
      <!-- Organisations -->
      <div class="container">
        <p id="notice"><%= notice %></p>
        <table class="table">
          <thead class="thead-light">
            <tr>
              <th>Institution</th>
              <th>Country</th>
              <th>City</th>
              <th>Affiliations</th>
            </tr>
          </thead>
          <tbody>
          <% organisations.each do |organisation| %>
            <tr>
              <td>
                <%= link_to organisation.name, organisation %>
              </td>
              <td>
                <%= organisation.country %>
              </td>
              <td>
                <%= organisation.city %>
              </td>          
              <td>
                <%= organisation.affiliations.count %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div><!-- col right DIV: list -->
  <div><!-- details row -->
<div>
