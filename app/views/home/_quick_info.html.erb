<!--Big Buttons-->

<div class="row my-1"><!-- Qucik info row -->
  <div class="col-sm col-6">
    <a href="/articles" class="btn btn-warning btn-block text-center text-light" style="width: 100%;" >
      <div class="container"><!-- info box -->
        <div class="row rounded ">
          <div class="col-sm-6">
            <h1><%= number_with_delimiter(Article.active.length()) %></h1>
          </div>
          <div class="col-sm my-1">
            <%= image_tag('books2.svg', height: '48', width: '48', class: "rounded float-end d-block") %>
          </div>
        </div>
        <b>Publications</b>
      </div> <!-- info box -->
    </a>
  </div>
  <div class="col-sm col-6">
    <a href="/authors" class="btn btn-info btn-block text-center text-light" style="width: 100%;" >
      <div class="container"><!-- info box -->
        <div class="row rounded ">
          <div class="col-sm-6">
            <h1><%= number_with_delimiter(Author.active.length()) %></h1>
          </div>
          <div class="col-sm my-1">
            <%= image_tag('users.svg', height: '48', width: '48', class: "rounded float-end d-block") %>
          </div>
        </div>
        <b>Researchers</b>
      </div> <!-- info box -->
    </a>
  </div>
  <div class="col-sm col-6">
    <a href="/organisations" class="btn btn-success btn-block text-center text-light" style="width: 100%;" >
    <div class="container"><!-- info box -->
      <div class="row rounded ">
        <div class="col-sm-6">
          <h1><%= number_with_delimiter(Organisation.active_org.count()) %></h1>
        </div>
        <div class="col-sm my-1">
          <%= image_tag('institution.svg', height: '48', width: '48', class: "rounded float-end d-block") %>
        </div>
      </div>
      <b>Institutions</b>
    </div> <!-- info box -->
   </a>
  </div>
  <% if do_data.visible %>
  <div class="col-sm col-6">
    <a href="/datasets" class="btn btn-danger btn-block text-center text-light"  style="width: 100%;">
    <div class="container"><!-- info box -->
      <div class="row rounded ">
        <div class="col-sm-6">
          <h1><%= number_with_delimiter(Dataset.count()) %></h1>
        </div>
        <div class="col-sm my-1">
          <%= image_tag('database.svg', height: '48', width: '48', class: "rounded float-end d-block") %>
        </div>
      </div>
      <b>Data Objects</b>
    </div> <!-- info box -->
   </a>
  </div>
  <% end %>
</div>
